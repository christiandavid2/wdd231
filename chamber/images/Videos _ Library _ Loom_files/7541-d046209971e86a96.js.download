        __typename
      }
      signedThumbnails {
        animatedPreview
        default
        default4X3
        defaultPlay
        ogFull
        full
        fullPlay
        defaultGif
        defaultGifPlay
      }
      dashUrl: nullableRawCdnUrl(acceptableMimes: [DASH], password: $password) {
        url
        credentials {
          Policy
          Signature
          KeyPairId
        }
      }
      hlsUrl: nullableRawCdnUrl(acceptableMimes: [M3U8], password: $password) {
        url
        credentials {
          Policy
          Signature
          KeyPairId
        }
      }
      active_video_transcript_id
      archived
      chapters
      comments_enabled
      comments_email_enabled
      complete
      createdAt
      cta {
        enabled
        url
        text
        mods
        is_auto
        approved_at
      }
      currentUserCanEdit
      current_user_is_owner
      description
      download_enabled
      downloadable
      downloadableBy
      email_gate_video_type
      stylizedCaptions
      viewerCaptionsOn
      folder_id
      folder {
        id
        special_id
        name
        visibility
      }
      isCommunityLoom
      viewer_marked_for_watch_later: isOnWatchLaterList
      isParentOfPersonalizedCopies
      personalizationType
      isMeetingRecording
      calendarMeetingGuid
      is_protected
      is_team_shared: isTeamShared
      loom_branded_player
      name
      needs_password
      organization_idv2
      organization {
        name
        brand_logo_path: brandLogoPath
        brand_show_branding: brandShowBranding
        brand_primary_color: brandPrimaryColor
        createdAt
        description
        planIncludesAI
        hidden
        id
        organization_properties
        site_id
        status
        tags
        trial_ended
        trial_ends_at
        trial_type
        type
        updatedAt
        workspace_logo_path: workspaceLogoPath
      }
      owner_id
      owner {
        id
        first_name
        display_name
        avatars {
          name
          large
          thumb
          iosLarge
          iosThumb
          isAtlassianMastered
        }
        status
        profile {
          profileInfo {
            role
            location
          }
          profileUrl
        }
      }
      privacy
      processing_information {
        instant_editing_enabled
        noise_cancellation_type
        replacements {
          type
        }
        trim_id
        trim_ranges {
          from
          to
        }
        videoUploadMessage
        videoUploadValid
        trim_progress
        split_segment_ttl
      }
      record_reply_enabled
      s3_id
      salesforce_engagement_tracking
      show_analytics_to_viewer
      show_transcript_to_viewer
      spaces {
        id
        name
        data_age_limit_in_seconds
        isArchived
        is_primary
        privacy
      }
      suggested_playback_rate
      use_emojis
      use_gif
      video_properties {
        avgBitRate
        client
        camera_enabled
        client_version
        countdown
        duration
        durationMs
        externalUpload
        format
        height
        ingestion_type
        liveRewindTrimmedSections
        mediaMetadataRotation
        microphone_enabled
        os
        os_version
        recordingClient
        recording_type
        recording_version
        screen_type
        sdkPartnerIdv2
        tab_audio
        trim_duration
        width
      }
      playable_duration
      signedDefaultThumbnails {
        default
        static
      }
      source_duration
      thumbnails {
        default
        default4X3
        defaultPlay
        ogFull
        full
        fullPlay
        defaultGif
        defaultGifPlay
        animatedPreview
      }
      viewerNeedsPermission
