      transcription_status
      processing_start_time
      processing_end_time
      createdAt
      updatedAt
      source_url
      captions_source_url
      captionsTranslatedLanguage
      captionsInOriginalLanguage
      captionsTranslationInProgress
      captionTranslationErrorFallback
      language
    }
    ... on InvalidRequestWarning {
      message
    }
    ... on GenericError {
      message
    }
  }
}
