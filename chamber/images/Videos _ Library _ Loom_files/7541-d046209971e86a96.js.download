  createSupportTicketNonLoggedInUser(
    subject: $subject
    category: $category
    issue: $issue
    platform: $platform
    priority: $priority
    message: $message
    videoUrl: $videoUrl
    permissionToImpersonate: $permissionToImpersonate
    chatHistory: $chatHistory
    userLocale: $userLocale
    userTimezoneOffset: $userTimezoneOffset
    email: $email
    conversationId: $conversationId
