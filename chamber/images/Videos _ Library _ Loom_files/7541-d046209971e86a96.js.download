    query GetWorkspaceSetting($settingName: String!, $includeTimestamps: Boolean = false) {
  getWorkspaceSetting(
    settingName: $settingName
    includeTimestamps: $includeTimestamps
  ) {
    ... on Setting {
      id
      setting {
        __typename
        ... on BooleanObject {
          id
          booleanValue: value
        }
        ... on IntObject {
          id
          intValue: value
        }
        ... on StringObject {
          id
          stringValue: value
        }
        ... on JSONObject {
          id
          jsonValue: value
        }
      }
      createdAt @include(if: $includeTimestamps)
      updatedAt @include(if: $includeTimestamps)
    }
